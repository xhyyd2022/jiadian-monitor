{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jiaidian-monitor",
  "version": "0.6.0",
  "identifier": "com.jiaidian.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "jiaidian-monitor",
        "width": 780,
        "height": 540,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
