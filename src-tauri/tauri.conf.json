{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jiadian-monitor",
  "version": "0.9.0",
  "identifier": "com.jiadian.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "jiadian-monitor",
        "width": 780,
        "height": 540,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "visible": false,
        "additionalBrowserArgs": "--remote-debugging-port=9333 --disable-features=CalculateNativeWinOcclusion,msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
